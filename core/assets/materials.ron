    (id: 30, key: "coal", name: "Kohle", category: Ore, color: (36, 34, 34), accent: Some((90, 90, 104)), hardness: 2.0, density: 1.4, toughness: 0.25, conductivity: 0.25, traces: [(Sulfur, 3.0), (Phosphorus, 0.1)]),
