; Bindet terraforge-core über gdext ein (#10). Bauen: siehe client/README.md.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../gdext/target/debug/libterraforge_gdext.so"
linux.release.x86_64 = "res://../gdext/target/release/libterraforge_gdext.so"
